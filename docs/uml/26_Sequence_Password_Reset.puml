@startuml 26_Sequence_Password_Reset
title Sequence - Password Reset (D30, D31; non-disclosing)
autonumber
actor User
participant "AuthController" as C
participant "PasswordResetService" as PS
participant "RateLimiter" as RL
participant "UserAccountRepository" as UR
participant "PasswordResetTokenRepository" as TR
participant "TokenService" as TS
participant "AuditService" as AU
participant "EmailService" as ES
participant "SessionRegistry" as SR

User -> C : POST /password-reset (email, CSRF)
C -> PS : requestReset(email, clientInfo)
PS -> RL : allow(emailHash, ip)?
alt rate limit exceeded
  PS --> C : (silently ignored)
else allowed
  group TX RW
    PS -> UR : findByEmail(normalized)
    alt account exists and not DISABLED
      PS -> TR : invalidate open tokens of user
      PS -> TS : generate()
      PS -> TR : save(hash, expires = now + 30 min)
      PS -> AU : record(PASSWORD_RESET_REQUESTED, email hash)
      PS -> PS : publish PasswordResetEmailRequested
    else unknown email
      PS -> PS : dummy BCrypt work (timing equalization)
    end
  end
  PS -> ES : AFTER_COMMIT sendPasswordResetEmail (only if requested)
end
C --> User : ALWAYS "If an account exists, we sent a link"

== User opens link and sets new password ==
User -> C : POST /password-reset/{raw} (new password, confirm, CSRF)
C -> PS : resetPassword(raw, new, confirm)
group TX RW
  PS -> TR : findByHash(sha256(raw))
  alt valid, unused, unexpired
    PS -> UR : changePassword(BCrypt(new)); clear lockout;\nverify email if PENDING_VERIFICATION (DA-41)
    PS -> TR : markUsed; invalidate other open reset tokens
    PS -> AU : record(PASSWORD_RESET_COMPLETED)
  else invalid / expired
    PS --> C : INVALID
    C --> User : "Link invalid or expired" + request form
  end
end
PS -> SR : AFTER_COMMIT expire all sessions of user
C --> User : redirect to login "Password changed"
@enduml
