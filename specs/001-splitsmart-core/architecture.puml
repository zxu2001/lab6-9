@startuml architecture
title SplitSmart - Layered + MVC summary (v2; detailed diagrams in docs/uml)
skinparam componentStyle rectangle

package "Presentation (Spring MVC + Thymeleaf)" {
  [Controllers] as Controllers
  [Thymeleaf Views] as Views
  [Forms and View Models] as Models
}

package "Application (services, @Transactional)" {
  [Application Services] as Services
  [AuthorizationService] as Authz
  interface "EmailService" as IEmail
}

package "Domain" {
  [Entities and Value Objects] as DomainModel
  [Financial Rules\n(SplitAllocator, BalanceCalculator,\nSettlementPlanner)] as Rules
  interface "Repository interfaces" as IRepo
}

package "Infrastructure" {
  [JPA Repository Adapters] as Repositories
  [SES / Mock Email Adapter] as Email
  [Spring Security Configuration] as Security
}

database "PostgreSQL (Amazon RDS)" as DB
cloud "Amazon SES" as SES

Security --> Controllers : authenticated requests
Controllers --> Models
Controllers --> Views
Controllers --> Services
Services --> Authz
Services --> DomainModel
Services --> Rules
Services --> IRepo
Services --> IEmail
Rules --> DomainModel
Repositories ..|> IRepo
Email ..|> IEmail
Repositories --> DB
Email --> SES

note right of DomainModel
  No Spring MVC, Thymeleaf, PostgreSQL,
  SES or infrastructure types (ADR-001).
end note
@enduml
