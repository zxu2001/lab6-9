@startuml 09-use-cases
title SplitSmart prototype – Use cases
left to right direction
actor "Demo user\n(any group member)" as M
actor "Approver\n(participant or payer\n≠ creator)" as A
M <|-- A

rectangle SplitSmart {
  usecase "Switch demo user\n(cookie, no password)" as UC0
  usecase "View dashboard &\ngroup summaries" as UC1
  usecase "View group\n(expenses / balances)" as UC2
  usecase "Add expense\n(equal or % split)" as UC3
  usecase "Approve / reject\nexpense" as UC4
  usecase "Settle up\n(record payment)" as UC5
  usecase "View notifications /\nmark all read" as UC6
  usecase "View reports" as UC7
  usecase "View expense detail" as UC8
}
M --> UC0
M --> UC1
M --> UC2
M --> UC3
M --> UC5
M --> UC6
M --> UC7
M --> UC8
A --> UC4
UC3 ..> UC4 : <<triggers>>\nnotifications
@enduml
